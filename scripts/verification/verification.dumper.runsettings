<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Keep the required boundary fully executable while the existing FIXME test remains [Ignore]. -->
    <TestCaseFilter>FullyQualifiedName!=Dumper.Tests.TruncatedLabelTests.TestVeryLongPath_PreservesFilename</TestCaseFilter>
    <TreatTestAdapterErrorsAsWarnings>false</TreatTestAdapterErrorsAsWarnings>
  </RunConfiguration>
  <NUnit>
    <ExplicitMode>Strict</ExplicitMode>
    <FailIfNoTests>true</FailIfNoTests>
  </NUnit>
</RunSettings>
